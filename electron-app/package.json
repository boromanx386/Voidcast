{
  "name": "voidcast",
  "version": "2.9.3",
  "main": "dist-electron/main/index.js",
  "description": "Desktop AI agent with multi-provider tool calling, integrated coding IDE, and TTS/STT.",
  "author": "https://github.com/boromanx386/Voidcast",
  "repository": {
    "type": "git",
    "url": "https://github.com/boromanx386/Voidcast.git"
  },
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm --prefix .. run build:tools-exe && npm run build:web && tsc && vite build && electron-builder --win",
    "build:publish": "npm --prefix .. run build:tools-exe && npm run build:web && tsc && vite build && electron-builder --win --publish always",
    "build:web": "tsc && vite build --config vite.config.web.ts",
    "build:dir": "npm --prefix .. run build:tools-exe && npm run build:web && tsc && vite build && electron-builder --win --dir",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.18.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5"
  }
}
