# Default: every text file is normalized to LF, both in the repo and in the
# worktree. Without this, core.autocrlf=true on Windows checks .ts/.tsx/.md/.json
# out as CRLF and every tool report shows EOL churn.
* text=auto eol=lf

# Windows-only launchers must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Native binaries / LFS payloads must never go through the eol machinery.
tts-server/vendor/cactus/whistle.cact filter=lfs diff=lfs merge=lfs -text
tts-server/vendor/cactus/libneedle.dll filter=lfs diff=lfs merge=lfs -text

# Force LF for scripts that run on Linux/macOS (git autocrlf would otherwise
# rewrite these to CRLF on checkout -> "bad interpreter: /bin/bash^M").
*.sh text eol=lf
*.py text eol=lf
